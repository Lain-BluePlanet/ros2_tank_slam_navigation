<?xml version="1.0"?>
<robot name="my_tank_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/> 
    </joint>
    <!-- 1. 定义变量 -->
    <xacro:property name="wheel_radius" value="0.12"/>
    <xacro:property name="wheel_length" value="0.06"/>
    <xacro:property name="wheel_offset_y" value="0.23"/> <!-- 加宽轮距，防止轮子插进车身 -->

    <!-- 2. 底盘 -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.8 0.4 0.15"/>
            </geometry>
            <material name="red_transparent">
                <color rgba="1 0 0 0.5"/>
            </material>
        </visual>
        <!-- 物理碰撞与质量 -->
        <collision>
            <geometry>
                <box size="0.8 0.4 0.15"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="5.0"/>
            <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.35"/>
        </inertial>
    </link>

    <!-- Gazebo 专属红色材质（必须写在 link 外面） -->
    <gazebo reference="base_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- 3. 定义轮子的宏 -->
    <xacro:macro name="my_wheel" params="prefix y_mul x_pos">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="purple">
                    <color rgba="0.6 0.2 1.0 1.0"/>
                </material>
            </visual>
            <!-- 物理碰撞与质量 -->
            <collision>
                <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.2"/>
                <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
            </inertial>
        </link>

        <!-- Gazebo 专属紫色材质（必须写在 link 外面） -->
        <gazebo reference="${prefix}_wheel">
            <mu1>1.0</mu1>
            <mu2>0.5</mu2>
            <material>Gazebo/Purple</material>
        </gazebo>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_pos} ${wheel_offset_y * y_mul} -0.03" rpy="0 0 0"/> 
            <axis xyz="0 1 0"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>
    </xacro:macro>

    <!-- 4. 召唤 6 个轮子 -->
    <xacro:my_wheel prefix="left_front"  y_mul="1"  x_pos="0.3" />
    <!--<xacro:my_wheel prefix="left_mid"    y_mul="1"  x_pos="0.0" />-->
    <xacro:my_wheel prefix="left_rear"   y_mul="1"  x_pos="-0.3" />

    <xacro:my_wheel prefix="right_front" y_mul="-1" x_pos="0.3" />
    <!--<xacro:my_wheel prefix="right_mid"   y_mul="-1" x_pos="0.0" />-->
    <xacro:my_wheel prefix="right_rear"  y_mul="-1" x_pos="-0.3" />


    <!-- 👇👇👇 就是这段，强制把后轮的摩擦力变成 0.01，让它们当万向轮 👇👇👇 -->
    <gazebo reference="left_rear_wheel">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>
    
    <gazebo reference="right_rear_wheel">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>
<!-- 👇 这个标签是专门给 Gazebo 看的，用来加载电机和车轮控制 👇 -->
    <gazebo>
        <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
            <!-- 1. 让哪一个节点来管这辆车？（30Hz更新频率） -->
            <update_rate>30</update_rate>
            
            <!-- 2. 选哪两个轮子当“驱动轮”？（六轮车咱们选中间那对当动力轮） -->
            <left_joint>left_front_wheel_joint</left_joint>
            <right_joint>right_front_wheel_joint</right_joint>
            
            <!-- 3. 轮子的物理参数（轮径和轮距，跟你上面的变量保持一致） -->
            <wheel_separation>0.46</wheel_separation>
            <wheel_diameter>0.24</wheel_diameter>
            
            <!-- 4. 电机的最大力气和加速度（如果太小，车会推不动） -->
            <max_wheel_torque>30.0</max_wheel_torque>
            <max_wheel_acceleration>5.0</max_wheel_acceleration>
            
            <!-- 5. 核心：你要给车发指令，发到哪个话题？ -->
            <command_topic>cmd_vel</command_topic>
            
            <!-- 6. 开启里程计（把车跑的距离和位置反馈给系统） -->
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>

        <!-- 👇👇👇 新增：专门用来发布所有轮子 /joint_states 的插件 👇👇👇 -->
        <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <ros>
                <remapping>~/out:=joint_states</remapping>

            </ros>
            <update_rate>30</update_rate>

            <!-- 这里列出你需要发布的轮子关节名字，必须和你上面 defined 的一模一样 -->
            <joint_name>left_front_wheel_joint</joint_name>
            <joint_name>right_front_wheel_joint</joint_name>
            <joint_name>left_rear_wheel_joint</joint_name>
            <joint_name>right_rear_wheel_joint</joint_name>
        </plugin>
        <!--上面是发布轮子的插件-->
    </gazebo>
    <!-- ======================= 激光雷达模块 ======================= -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/> <!-- 车顶的小黑圆柱 -->
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed"> <!-- 焊死在车顶，不能动 -->
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.25" rpy="0 0 0"/> <!-- 抬高 0.1 米装车顶 -->
    </joint>
    <gazebo reference="lidar_link">
        <sensor type="ray" name="lidar_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize> <!-- 开启Gazebo里的红线可视化 -->
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples> <!-- 一圈打360个点 -->
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>10.0</max> <!-- 最远看10米 -->
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <!-- 核心插件：把物理数据变成 ROS 2 话题 -->
            <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_link</frame_name>
                <qos_profile>
                    <reliability>best_effort</reliability>
                </qos_profile>
            </plugin>

        </sensor>
    </gazebo>
    <!-- ============================================================ -->

</robot>